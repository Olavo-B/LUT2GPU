# Lê a tabela verdade
# read_pla   

# Executa a síntese geral
synth

# Chama o ABC com os comandos desejados
abc -script /app/results/blif_generator/abc_script.abc  


# Salva o Verilog resultante
# write_verilog /app/results/blif_generator/somador.v  

# Gera o arquivo DOT do circuito
# write_dot /app/results/blif_generator/somador.dot  

# Salva o BLIF final
# write_blif /app/results/blif_generator/somador.blif